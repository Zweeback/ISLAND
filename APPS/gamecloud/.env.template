# GameCloud – environment variable template
# Copy to .env (git-ignored) and fill in real values.
# NEVER commit real keys.

# ── LLM Provider API Keys ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# ── Ollama (local LLM) ───────────────────────────────────────────────────────
# Default: http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3

# ── GameCloud Settings ───────────────────────────────────────────────────────
GAMECLOUD_ENV=development
GAMECLOUD_DEFAULT_PROVIDER=openai
GAMECLOUD_DEFAULT_MODEL=gpt-4o-mini
GAMECLOUD_MAX_TOKENS=2048
GAMECLOUD_LOG_LEVEL=INFO

# ── API Server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

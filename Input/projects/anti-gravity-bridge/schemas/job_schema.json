{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AntiGravityBridgeJob",
  "description": "Standard schema for tracking the lifecycle of background processes in the Anti-Gravity Bridge.",
  "type": "OBJECT",
  "properties": {
    "job_id": {
      "type": "STRING",
      "description": "Unique identifier (UUID) for this job."
    },
    "job_type": {
      "type": "STRING",
      "enum": ["render", "photogrammetry", "editor_sync"],
      "description": "Subsystem pipeline type."
    },
    "status": {
      "type": "STRING",
      "enum": ["pending", "running", "completed", "failed"],
      "description": "Current lifecycle status."
    },
    "progress": {
      "type": "NUMBER",
      "minimum": 0,
      "maximum": 100,
      "description": "Percentage progress completion."
    },
    "payload": {
      "type": "OBJECT",
      "description": "Original command payload initiating this job."
    },
    "artifacts": {
      "type": "ARRAY",
      "items": {
        "type": "STRING"
      },
      "description": "List of paths to generated asset outputs."
    },
    "errors": {
      "type": "ARRAY",
      "items": {
        "type": "STRING"
      },
      "description": "List of error messages if the job failed."
    },
    "created_at": {
      "type": "STRING",
      "format": "date-time"
    },
    "updated_at": {
      "type": "STRING",
      "format": "date-time"
    }
  },
  "required": ["job_id", "job_type", "status", "progress", "payload", "artifacts", "errors"]
}
